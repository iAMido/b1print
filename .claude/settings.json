{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run serve)",
      "Bash(node --test:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(python3 -m b1print:*)",
      "Bash(pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": ["Bash(git push:*)"],
    "deny": ["Bash(rm -rf:*)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "bash .claude/hooks/validate-code.sh" }] }
    ]
  }
}
